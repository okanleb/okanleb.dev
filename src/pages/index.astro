---
import Layout from "../layouts/Layout.astro";
import ProfileImage from "../images/profile.jpg"; // Kendi fotoğrafının yolu (varsayılan: src/images/profile.jpg)
---

<Layout>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <!-- Profil fotoğrafı eklendi -->
        <div class="profile-container">
          <img class="profile-picture" src="/profile.jpg" alt="Mehmet Okan Leblebici" />
        </div>
        
        <h1>Mehmet Okan Leblebici</h1>
        <h2>Senior Mainframe System Engineer</h2>
        
        <p>
          Designing reliable IBM Mainframe solutions through&nbsp;<span class="accent">automation</span>,&nbsp;<span class="accent">simplicity</span>,&nbsp;and&nbsp;<span class="accent">Everything-as-Code</span>.
        </p>

        <div class="actions">
          <a class="button" href="/resume.pdf" target="_blank" rel="noopener noreferrer">
            <span>Download Resume</span>
          </a>
          <a class="link" href="https://www.linkedin.com/in/okanleblebici/" target="_blank" rel="noopener noreferrer">
            LinkedIn <span class="arrow">↗</span>
          </a>
          <a class="link" href="https://www.instagram.com/moleblebici/" target="_blank" rel="noopener noreferrer">
            Instagram <span class="arrow">↗</span>
          </a>
          <a class="link" href="mailto:okanleblebici@gmail.com">
            okanleblebici@gmail.com
          </a>
        </div>
      <div class="bio-section">
          <p class="bio-text">
            Senior Mainframe System Engineer with specialized expertise in z/OS environments, CICS, and enterprise middleware. Focused on modernizing mainframe operations, automating complex infrastructure workflows, and building highly resilient, high-performance systems for mission-critical operations.
          </p>

          <div class="expertise-card">
            <div class="card-header">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="card-title">system_spec.config</span>
            </div>
            
            <div class="card-body">
              <div class="skill-group">
                <span class="group-label">Core:</span>
                <div class="tags">
                  <span class="tag">IBM Mainframe</span>
                  <span class="tag">CICS Administration</span>
                  <span class="tag">IBM MQ</span>
                  <span class="tag">CICS Transaction Gateway</span>
                  <span class="tag">z/OS</span>
                  <span class="tag">TXSeries</span>
                </div>
              </div>

              <div class="skill-group">
                <span class="group-label">Practices:</span>
                <div class="tags">
                  <span class="tag">Systems Administration & Engineering</span>
                  <span class="tag">Infrastructure Automation</span>
                  <span class="tag">High Availability & DR</span>
                  <span class="tag">Performance Optimization</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
