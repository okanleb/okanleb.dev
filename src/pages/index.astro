---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Mehmet Okan Leblebici"
  description="Senior Mainframe System Engineer"
>

<section class="hero">

    <div class="container">

        <div class="hero-content">

            <p class="eyebrow">
                Senior Mainframe System Engineer
            </p>

            <h1>
                Mehmet Okan Leblebici
            </h1>

            <p class="tagline">
                Designing reliable IBM Mainframe solutions through
                <span>automation</span>,
                <span>simplicity</span>
                and
                <span>Everything-as-Code</span>.
            </p>

            <div class="actions">

                <a class="button" href="#">
                    Resume
                </a>

                <a class="link" href="#">
                    LinkedIn
                </a>

                <a class="link" href="#">
                    GitHub
                </a>

                <a class="link" href="#">
                    Email
                </a>

            </div>

        </div>

    </div>

</section>

</Layout>
