:root{

--bg:#0b1120;
--text:#f8fafc;
--muted:#94a3b8;
--accent:#3b82f6;

--max-width:1280px;

}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{

background:var(--bg);
color:var(--text);

font-family:
Inter,
system-ui,
sans-serif;

}

a{

text-decoration:none;
color:inherit;

}

.container{

width:min(1280px,90%);
margin:auto;

}

.hero{

display:flex;
align-items:center;

min-height:100vh;

}

.hero-content{

max-width:900px;

}

.eyebrow{

font-size:18px;
color:var(--muted);

margin-bottom:20px;

}

.hero h1{

font-size:72px;
font-weight:800;

line-height:1.05;

letter-spacing:-2px;

margin-bottom:34px;

}

.tagline{

font-size:28px;

line-height:1.7;

max-width:760px;

color:#d4d4d8;

}

.tagline span{

color:var(--accent);

}

.actions{

margin-top:60px;

display:flex;

gap:28px;

align-items:center;

}

.button{

background:var(--accent);

padding:16px 30px;

border-radius:12px;

font-weight:600;

color:white;

transition:.2s;

}

.button:hover{

transform:translateY(-2px);

}

.link{

font-size:18px;

color:var(--muted);

transition:.2s;

}

.link:hover{

color:white;

}

@media(max-width:900px){

.hero{

padding:80px 0;

}

.hero h1{

font-size:54px;

}

.tagline{

font-size:22px;

}

.actions{

flex-wrap:wrap;

}

}
