---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mehmet Okan Leblebici",
  description = "Senior Mainframe System Engineer",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0b1120"
    />

    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>

    <slot />

  </body>
</html>
